# Copy this file to .env and fill in real values for local development.
# The app fails fast (refuses to start) if DATABASE_URL or SECRET_KEY are
# missing — there are no built-in defaults for either, on purpose. Never
# commit a real .env file or a real secret.

DATABASE_URL="mysql+pymysql://user:password@localhost/dbname"

# Generate a unique, securely-random value per environment, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Never reuse this example value anywhere real.
SECRET_KEY="replace-with-a-long-random-secret-per-environment"

# Comma-separated list of origins allowed to make cross-origin requests
# with credentials. Optional -- defaults to the local Vite/CRA dev
# ports if unset. Set this explicitly for staging/production.
# CORS_ORIGINS="https://app.example.com"
